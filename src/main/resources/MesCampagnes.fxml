<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack" styleClass="root-care" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MesCampagnesController">
   <Canvas fx:id="particleCanvas" />
   <BorderPane fx:id="rootPane" styleClass="border-content-care">
   <padding>
      <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
   </padding>
   <top>
      <VBox spacing="12.0" styleClass="panel-header">
         <VBox spacing="4.0">
            <Label styleClass="brand-title" text="Mes campagnes" />
            <Label styleClass="brand-subtitle" text="Vos demandes d'urgence et le suivi des campagnes publiées sur l'accueil." />
         </VBox>
         <Label styleClass="label-muted" text="Seules les demandes envoyées depuis cet ordinateur apparaissent ici (session locale)." wrapText="true" />
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="btnActualiser" mnemonicParsing="false" styleClass="btn-care-primary" text="Actualiser" />
            <Button fx:id="btnNouvelleDemande" mnemonicParsing="false" styleClass="btn-care-urgence" text="Nouvelle demande" />
            <Button fx:id="btnAccueil" mnemonicParsing="false" styleClass="btn-care-primary" text="Accueil" />
            <Button fx:id="btnEspaceAdmin" mnemonicParsing="false" styleClass="btn-care-primary" text="Espace admin" />
         </HBox>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-care" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="cardsContainer" spacing="12.0">
               <padding>
                  <Insets bottom="8.0" left="4.0" right="4.0" top="8.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   </BorderPane>
</StackPane>
