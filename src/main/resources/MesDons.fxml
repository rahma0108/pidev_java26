<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MesDonsController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <top>
      <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #d7deea; -fx-padding: 10;">
         <Label style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #26364b;" text="Mes dons" />
         <Label style="-fx-text-fill: #64748b;" text="Affiche les dons en attente et valides." />
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Recherche :" />
            <TextField fx:id="searchField" prefWidth="220.0" promptText="Texte, catégorie…" />
            <Label text="Statut :" />
            <ComboBox fx:id="statutCombo" prefWidth="130.0" />
            <Label style="-fx-text-fill: #16a34a; -fx-font-weight: bold;" text="▼ Filtres" />
         </HBox>
         <TitledPane fx:id="paneFiltres" animated="true" expanded="false" maxWidth="1.7976931348623157E308" style="-fx-border-color: #d7deea; -fx-border-radius: 8; -fx-background-radius: 8;" text="Filtres supplémentaires">
            <content>
               <VBox spacing="8.0">
                  <padding>
                     <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                  </padding>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label text="Urgence :" />
                     <ComboBox fx:id="filtreUrgenceCombo" prefWidth="120.0" />
                     <Label text="État :" />
                     <ComboBox fx:id="filtreEtatCombo" prefWidth="170.0" />
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label text="Unité :" />
                     <ComboBox fx:id="filtreUniteCombo" prefWidth="120.0" />
                     <Label text="Catégorie :" />
                     <ComboBox fx:id="filtreCategorieCombo" prefWidth="220.0" />
                     <Label text="Qté min :" />
                     <TextField fx:id="tfQuantiteMin" prefWidth="72.0" promptText="vide" />
                     <Label text="Qté max :" />
                     <TextField fx:id="tfQuantiteMax" prefWidth="72.0" promptText="vide" />
                  </HBox>
               </VBox>
            </content>
         </TitledPane>
         <TitledPane fx:id="paneTri" animated="true" expanded="false" maxWidth="1.7976931348623157E308" style="-fx-border-color: #d7deea; -fx-border-radius: 8; -fx-background-radius: 8;" text="Tri multi-critères">
            <content>
               <VBox spacing="6.0">
                  <padding>
                     <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                  </padding>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <Label style="-fx-font-weight: bold;" text="1" />
                     <ComboBox fx:id="tri1ChampCombo" prefWidth="150.0" />
                     <ComboBox fx:id="tri1OrdreCombo" prefWidth="110.0" />
                     <Label style="-fx-font-weight: bold;" text="2" />
                     <ComboBox fx:id="tri2ChampCombo" prefWidth="150.0" />
                     <ComboBox fx:id="tri2OrdreCombo" prefWidth="110.0" />
                     <Label style="-fx-font-weight: bold;" text="3" />
                     <ComboBox fx:id="tri3ChampCombo" prefWidth="150.0" />
                     <ComboBox fx:id="tri3OrdreCombo" prefWidth="110.0" />
                  </HBox>
               </VBox>
            </content>
         </TitledPane>
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="btnAjouter" mnemonicParsing="false" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 9; -fx-font-weight: bold;" text="Ajouter" />
            <Button fx:id="btnModifier" disable="true" mnemonicParsing="false" style="-fx-background-radius: 9; -fx-font-weight: bold;" text="Modifier" />
            <Button fx:id="btnSupprimer" disable="true" mnemonicParsing="false" style="-fx-background-radius: 9; -fx-font-weight: bold;" text="Supprimer" />
            <Button fx:id="btnAccueil" mnemonicParsing="false" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 9; -fx-font-weight: bold;" text="Accueil" />
            <Button fx:id="btnEspaceAdmin" mnemonicParsing="false" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 9; -fx-font-weight: bold;" text="Espace admin" />
         </HBox>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="cardsContainer" spacing="10.0">
               <padding>
                  <Insets bottom="4.0" left="2.0" right="2.0" top="4.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
