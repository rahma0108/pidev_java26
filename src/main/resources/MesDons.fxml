<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack" styleClass="root-care" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MesDonsController">
   <Canvas fx:id="particleCanvas" />
   <BorderPane fx:id="rootPane" styleClass="border-content-care">
   <padding>
      <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
   </padding>
   <top>
      <VBox spacing="12.0" styleClass="panel-header">
         <VBox spacing="4.0">
            <Label styleClass="brand-title" text="Mes dons" />
            <Label styleClass="brand-subtitle" text="Affiche les dons en attente et valides." />
         </VBox>
         <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label styleClass="label-muted" text="Recherche :" />
            <TextField fx:id="searchField" prefWidth="220.0" promptText="Texte, catégorie…" styleClass="field-care" />
            <Label styleClass="label-muted" text="Statut :" />
            <ComboBox fx:id="statutCombo" prefWidth="130.0" styleClass="combo-box combo-box-base" />
            <Label styleClass="badge-filtres" text="▼ Filtres" />
         </HBox>
         <TitledPane fx:id="paneFiltres" animated="true" expanded="false" maxWidth="1.7976931348623157E308" styleClass="titled-pane-care" text="Filtres supplémentaires">
            <content>
               <VBox spacing="10.0">
                  <padding>
                     <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                  </padding>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <Label styleClass="label-muted" text="Urgence :" />
                     <ComboBox fx:id="filtreUrgenceCombo" prefWidth="120.0" styleClass="combo-box combo-box-base" />
                     <Label styleClass="label-muted" text="État :" />
                     <ComboBox fx:id="filtreEtatCombo" prefWidth="170.0" styleClass="combo-box combo-box-base" />
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <Label styleClass="label-muted" text="Unité :" />
                     <ComboBox fx:id="filtreUniteCombo" prefWidth="120.0" styleClass="combo-box combo-box-base" />
                     <Label styleClass="label-muted" text="Catégorie :" />
                     <ComboBox fx:id="filtreCategorieCombo" prefWidth="220.0" styleClass="combo-box combo-box-base" />
                     <Label styleClass="label-muted" text="Qté min :" />
                     <TextField fx:id="tfQuantiteMin" prefWidth="72.0" promptText="vide" styleClass="field-care" />
                     <Label styleClass="label-muted" text="Qté max :" />
                     <TextField fx:id="tfQuantiteMax" prefWidth="72.0" promptText="vide" styleClass="field-care" />
                  </HBox>
               </VBox>
            </content>
         </TitledPane>
         <TitledPane fx:id="paneTri" animated="true" expanded="false" maxWidth="1.7976931348623157E308" styleClass="titled-pane-care" text="Tri multi-critères">
            <content>
               <VBox spacing="8.0">
                  <padding>
                     <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                  </padding>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label style="-fx-font-weight: bold; -fx-text-fill: #93c5fd;" text="1" />
                     <ComboBox fx:id="tri1ChampCombo" prefWidth="150.0" styleClass="combo-box combo-box-base" />
                     <ComboBox fx:id="tri1OrdreCombo" prefWidth="110.0" styleClass="combo-box combo-box-base" />
                     <Label style="-fx-font-weight: bold; -fx-text-fill: #93c5fd;" text="2" />
                     <ComboBox fx:id="tri2ChampCombo" prefWidth="150.0" styleClass="combo-box combo-box-base" />
                     <ComboBox fx:id="tri2OrdreCombo" prefWidth="110.0" styleClass="combo-box combo-box-base" />
                     <Label style="-fx-font-weight: bold; -fx-text-fill: #93c5fd;" text="3" />
                     <ComboBox fx:id="tri3ChampCombo" prefWidth="150.0" styleClass="combo-box combo-box-base" />
                     <ComboBox fx:id="tri3OrdreCombo" prefWidth="110.0" styleClass="combo-box combo-box-base" />
                  </HBox>
               </VBox>
            </content>
         </TitledPane>
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="btnAjouter" mnemonicParsing="false" styleClass="btn-care-primary" text="Ajouter" />
            <Button fx:id="btnModifier" disable="true" mnemonicParsing="false" styleClass="btn-care-secondary" text="Modifier" />
            <Button fx:id="btnSupprimer" disable="true" mnemonicParsing="false" styleClass="btn-care-secondary" text="Supprimer" />
            <Button fx:id="btnAccueil" mnemonicParsing="false" styleClass="btn-care-primary" text="Accueil" />
            <Button fx:id="btnMesCampagnes" mnemonicParsing="false" styleClass="btn-care-primary" text="Mes campagnes" />
            <Button fx:id="btnEspaceAdmin" mnemonicParsing="false" styleClass="btn-care-primary" text="Espace admin" />
         </HBox>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-care" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="cardsContainer" spacing="12.0">
               <padding>
                  <Insets bottom="8.0" left="4.0" right="4.0" top="8.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   </BorderPane>
</StackPane>
