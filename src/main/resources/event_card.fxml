<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<VBox xmlns:fx="http://javafx.com/fxml" 
      fx:controller="userfx.EventCardController"
      prefWidth="280" prefHeight="220" spacing="15" alignment="CENTER"
      style="-fx-background-color: rgba(15, 23, 42, 0.6); 
             -fx-background-radius: 24; 
             -fx-border-color: rgba(255, 255, 255, 0.1); 
             -fx-border-radius: 24; 
             -fx-border-width: 1;
             -fx-padding: 25;">

    <!-- ICON AREA -->
    <StackPane style="-fx-background-color: rgba(16, 185, 129, 0.1); -fx-background-radius: 12; -fx-padding: 10;">
         <Label text="📅" style="-fx-font-size: 24px;"/>
    </StackPane>

    <!-- INFO -->
    <VBox alignment="CENTER" spacing="5">
        <Label fx:id="titleLabel" text="Event Title" 
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="locationLabel" text="Tunis, Tunisia" 
               style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- BADGE/BUTTONS -->
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="participateBtn" onAction="#handleParticipate"
                style="-fx-background-color: rgba(16, 185, 129, 0.15); 
                       -fx-text-fill: #10b981; 
                       -fx-background-radius: 15; 
                       -fx-padding: 6 15; 
                       -fx-font-size: 12px; 
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-border-color: rgba(16, 185, 129, 0.3);
                       -fx-border-radius: 15;"/>
        
        <Button onAction="#handleQR" text="QR"
                style="-fx-background-color: rgba(255, 255, 255, 0.05); 
                       -fx-text-fill: white; 
                       -fx-background-radius: 15; 
                       -fx-padding: 6 12; 
                       -fx-font-size: 12px; 
                       -fx-cursor: hand;
                       -fx-border-color: rgba(255, 255, 255, 0.2);
                       -fx-border-radius: 15;"/>
    </HBox>

</VBox>
