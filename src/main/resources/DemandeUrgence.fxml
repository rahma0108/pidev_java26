<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="demande-urgence-root" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DemandeUrgenceController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="dem-urg-header">
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <Button fx:id="btnRetour" mnemonicParsing="false" styleClass="btn-dem-urg-back" text="← Retour" />
         <Region HBox.hgrow="ALWAYS" />
         <Label styleClass="dem-urg-page-title" text="Demande d'urgence" />
         <Region prefWidth="80.0" />
      </HBox>
   </top>
   <center>
      <ScrollPane fx:id="scrollContenu" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="dem-urg-scroll" BorderPane.alignment="CENTER">
         <content>
            <HBox alignment="TOP_LEFT" maxHeight="1.7976931348623157E308" spacing="20.0" styleClass="dem-urg-body">
               <padding>
                  <Insets bottom="24.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <VBox minWidth="200.0" prefWidth="260.0" spacing="14.0" styleClass="dem-urg-card-side">
                  <padding>
                     <Insets bottom="20.0" left="18.0" right="18.0" top="20.0" />
                  </padding>
                  <Label alignment="CENTER" styleClass="dem-urg-side-icon" text="!" />
                  <Label styleClass="dem-urg-side-title" text="Signalement urgent" wrapText="true" />
                  <HBox spacing="8.0">
                     <Label styleClass="dem-urg-badge" text="ADMIN" />
                     <Label styleClass="dem-urg-badge dem-urg-badge-ok" text="CONFIDENTIEL" />
                  </HBox>
                  <Separator styleClass="dem-urg-sep" />
                  <Label styleClass="dem-urg-section-title" text="Comment ça marche ?" />
                  <Label styleClass="label-dim" text="Décrivez votre situation (français ou tunisien). Ce message n'apparaît pas sur l'accueil public : il est transmis à l'équipe administrateur." wrapText="true" />
                  <Label styleClass="label-dim" text="Un admin lit votre demande et peut lancer une campagne d'aide publique (avec l'IA) si c'est pertinent — ou classer la demande sans campagne." wrapText="true" />
               </VBox>
               <VBox maxWidth="1.7976931348623157E308" spacing="16.0" styleClass="dem-urg-card-main" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                  </padding>
                  <Label styleClass="dem-urg-form-title" text="Votre message" />
                  <Label styleClass="label-muted" text="Minimum 8 caractères, maximum 4000. Incluez les montants ou besoins précis si nécessaire." wrapText="true" />
                  <TextArea fx:id="txtMessage" prefRowCount="14" promptText="Exemple : besoin de 3000 dinars pour une opération, groupe sanguin, contact…" styleClass="dem-urg-textarea" wrapText="true" VBox.vgrow="ALWAYS" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Button fx:id="btnAjouterImage" mnemonicParsing="false" styleClass="btn-dem-urg-back" text="Ajouter image justificative" />
                     <Hyperlink fx:id="linkRetirerImage" text="Retirer" visible="false" managed="false" />
                     <Label fx:id="lblImageSelectionnee" styleClass="label-muted" text="Aucune image sélectionnée" />
                  </HBox>
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <Button fx:id="btnEnvoyer" mnemonicParsing="false" styleClass="btn-care-primary" text="Envoyer aux équipes" />
                  </HBox>
               </VBox>
            </HBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
