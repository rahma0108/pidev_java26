<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ForgotPasswordController"
           prefWidth="1000" prefHeight="650"
           style="-fx-background-color: #050d1a;">

    <Canvas fx:id="animCanvas" width="1000" height="650"/>

    <VBox alignment="CENTER" spacing="0">

        <!-- TOP BAR -->
        <HBox alignment="CENTER_LEFT" prefWidth="1000"
              style="-fx-padding: 18 32;
                     -fx-background-color: rgba(5,13,26,0.85);
                     -fx-border-color: rgba(24,95,165,0.2);
                     -fx-border-width: 0 0 1 0;">
            <Label text="← Back to Login" onMouseClicked="#goToLogin"
                   style="-fx-text-fill: #7fc4fd; -fx-font-size: 13px; -fx-cursor: hand;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ImageView fitWidth="110" fitHeight="46" preserveRatio="true"
                       onMouseClicked="#goToLanding" style="-fx-cursor: hand;">
                <image><Image url="@/logo.png"/></image>
            </ImageView>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="themeToggleBtn" text="🌙" onAction="#toggleTheme"
                    style="-fx-background-color: rgba(255,255,255,0.08);
                           -fx-font-size: 15px; -fx-cursor: hand;
                           -fx-border-color: transparent; -fx-background-radius: 20;
                           -fx-padding: 5 10;"/>
        </HBox>

        <!-- MAIN CARD -->
        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <VBox spacing="20" maxWidth="420"
                  style="-fx-background-color: rgba(13,27,42,0.95);
                         -fx-background-radius: 20;
                         -fx-border-color: rgba(24,95,165,0.3);
                         -fx-border-radius: 20; -fx-border-width: 1;
                         -fx-padding: 44 40;">

                <!-- Icon -->
                <VBox alignment="CENTER" spacing="12">
                    <StackPane alignment="CENTER">
                        <Circle radius="40"
                                style="-fx-fill: rgba(24,95,165,0.2);
                                       -fx-stroke: rgba(24,95,165,0.4);
                                       -fx-stroke-width: 1.5;"/>
                        <Label text="🔑" style="-fx-font-size: 30px;"/>
                    </StackPane>
                    <Label text="Forgot Password?"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                    <Label text="Enter your email and we'll send you\na reset link right away."
                           style="-fx-font-size: 13px; -fx-text-fill: #8899aa;
                                  -fx-text-alignment: center; -fx-wrap-text: true;"
                           maxWidth="340"/>
                </VBox>

                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                <!-- Step 1: Email -->
                <VBox fx:id="step1Box" spacing="14">
                    <VBox spacing="6">
                        <Label text="Email Address"
                               style="-fx-font-size: 12px; -fx-text-fill: #7fc4fd;"/>
                        <TextField fx:id="emailField"
                                   promptText="you@example.com"
                                   prefHeight="42"
                                   style="-fx-background-color: rgba(255,255,255,0.06);
                                          -fx-text-fill: white;
                                          -fx-prompt-text-fill: #445566;
                                          -fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: rgba(24,95,165,0.3);
                                          -fx-border-width: 1; -fx-font-size: 14px;"/>
                    </VBox>

                    <Label fx:id="emailErrorLabel" text="" wrapText="true"
                           style="-fx-font-size: 12px;"/>

                    <Button text="Send Reset Code" onAction="#handleSendCode"
                            prefWidth="340" prefHeight="44"
                            style="-fx-background-color: #185FA5;
                                   -fx-text-fill: white; -fx-font-size: 14px;
                                   -fx-font-weight: bold; -fx-background-radius: 12;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>

                    <HBox alignment="CENTER" spacing="6">
                        <ProgressIndicator fx:id="spinner1"
                                           prefWidth="18" prefHeight="18"
                                           visible="false" managed="false"/>
                        <Label fx:id="sendingLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: #7fc4fd;"
                               visible="false" managed="false"/>
                    </HBox>
                </VBox>

                <!-- Step 2: Code + New Password (hidden initially) -->
                <VBox fx:id="step2Box" spacing="14"
                      visible="false" managed="false">

                    <Label text="✓ Code sent to your email!"
                           style="-fx-font-size: 13px; -fx-text-fill: #5DCAA5;
                                  -fx-background-color: rgba(29,158,117,0.12);
                                  -fx-background-radius: 8; -fx-padding: 8 12;"/>

                    <VBox spacing="6">
                        <Label text="Reset Code"
                               style="-fx-font-size: 12px; -fx-text-fill: #7fc4fd;"/>
                        <TextField fx:id="codeField"
                                   promptText="Enter 6-digit code"
                                   prefHeight="42"
                                   style="-fx-background-color: rgba(255,255,255,0.06);
                                          -fx-text-fill: white;
                                          -fx-prompt-text-fill: #445566;
                                          -fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: rgba(24,95,165,0.3);
                                          -fx-border-width: 1; -fx-font-size: 16px;
                                          -fx-alignment: CENTER;"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="New Password"
                               style="-fx-font-size: 12px; -fx-text-fill: #7fc4fd;"/>
                        <PasswordField fx:id="newPassField"
                                       promptText="Min 8 characters"
                                       prefHeight="42"
                                       style="-fx-background-color: rgba(255,255,255,0.06);
                                              -fx-text-fill: white;
                                              -fx-prompt-text-fill: #445566;
                                              -fx-background-radius: 10;
                                              -fx-border-radius: 10;
                                              -fx-border-color: rgba(24,95,165,0.3);
                                              -fx-border-width: 1; -fx-font-size: 14px;"/>
                    </VBox>

                    <!-- Strength bars -->
                    <HBox spacing="6">
                        <Region fx:id="sBar1" prefHeight="4" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 4;"/>
                        <Region fx:id="sBar2" prefHeight="4" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 4;"/>
                        <Region fx:id="sBar3" prefHeight="4" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 4;"/>
                        <Region fx:id="sBar4" prefHeight="4" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 4;"/>
                    </HBox>
                    <Label fx:id="strengthLabel" text=""
                           style="-fx-font-size: 11px; -fx-text-fill: #667788;"/>

                    <Label fx:id="resetErrorLabel" text="" wrapText="true"
                           style="-fx-font-size: 12px;"/>

                    <Button text="Reset Password" onAction="#handleResetPassword"
                            prefWidth="340" prefHeight="44"
                            style="-fx-background-color: #0F6E56;
                                   -fx-text-fill: white; -fx-font-size: 14px;
                                   -fx-font-weight: bold; -fx-background-radius: 12;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                </VBox>

            </VBox>
        </VBox>
    </VBox>
</StackPane>
