<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="DashboardController"
            prefWidth="960" prefHeight="620"
            style="-fx-background-color: #f0f4f8;">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="220" prefHeight="620"
              style="-fx-background-color: #185FA5;">

            <!-- Logo -->
            <VBox alignment="CENTER" style="-fx-padding: 24 16 16 16;">
                <ImageView fitWidth="140" fitHeight="60" preserveRatio="true">
                    <image><Image url="@/logo.png"/></image>
                </ImageView>
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.2);"/>

            <!-- Nav -->
            <VBox spacing="4" style="-fx-padding: 16 12;">
                <Button text="  Dashboard" onAction="#showDashboard"
                        prefWidth="196" prefHeight="42"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: transparent;"/>
                <Button text="  Users" onAction="#showUsers"
                        prefWidth="196" prefHeight="42"
                        style="-fx-background-color: transparent; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: transparent;"/>
                <Button text="  Appointments" onAction="#showAppointments"
                        prefWidth="196" prefHeight="42"
                        style="-fx-background-color: transparent; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: transparent;"/>
                <Button text="  Medications" onAction="#showMedications"
                        prefWidth="196" prefHeight="42"
                        style="-fx-background-color: transparent; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: transparent;"/>
                <Button text="  Events" onAction="#showEvents"
                        prefWidth="196" prefHeight="42"
                        style="-fx-background-color: transparent; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: transparent;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- User info card at bottom -->
            <VBox style="-fx-padding: 12;">
                <VBox style="-fx-background-color: rgba(255,255,255,0.15);
                             -fx-background-radius: 12; -fx-padding: 12 14;">
                    <Label fx:id="welcomeLabel" text="Welcome!"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="roleLabel" text=""
                           style="-fx-font-size: 11px; -fx-text-fill: #aad4f5;"/>
                </VBox>
                <Button text="Logout" onAction="#handleLogout"
                        prefWidth="196" prefHeight="36"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white;
                               -fx-font-size: 12px; -fx-background-radius: 10;
                               -fx-cursor: hand; -fx-border-color: transparent; -fx-margin: 8 0 0 0;"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20" style="-fx-padding: 28;">

                <!-- Page title -->
                <Label fx:id="pageTitle" text="Dashboard"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>

                <!-- STAT CARDS -->
                <HBox spacing="14">
                    <!-- Total Users -->
                    <VBox HBox.hgrow="ALWAYS" prefHeight="100" alignment="CENTER" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #e0e0e0; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <Label text="Total Users"
                               style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                        <Label fx:id="totalUsersLabel" text="—"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>
                        <Label text="registered accounts"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaa;"/>
                    </VBox>

                    <!-- Appointments -->
                    <VBox HBox.hgrow="ALWAYS" prefHeight="100" alignment="CENTER" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #e0e0e0; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <Label text="Appointments"
                               style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                        <Label fx:id="totalAppointmentsLabel" text="—"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #0F6E56;"/>
                        <Label text="scheduled"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaa;"/>
                    </VBox>

                    <!-- Medications -->
                    <VBox HBox.hgrow="ALWAYS" prefHeight="100" alignment="CENTER" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #e0e0e0; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <Label text="Medications"
                               style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                        <Label fx:id="totalMedsLabel" text="—"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #993C1D;"/>
                        <Label text="in stock"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaa;"/>
                    </VBox>

                    <!-- Events -->
                    <VBox HBox.hgrow="ALWAYS" prefHeight="100" alignment="CENTER" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #e0e0e0; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <Label text="Events"
                               style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                        <Label fx:id="totalEventsLabel" text="—"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #534AB7;"/>
                        <Label text="upcoming"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaa;"/>
                    </VBox>
                </HBox>

                <!-- QUICK ACTION CARDS -->
                <Label text="Quick Actions"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <HBox spacing="14">
                    <VBox HBox.hgrow="ALWAYS" prefHeight="110" alignment="CENTER" spacing="8"
                          onMouseClicked="#showUsers"
                          style="-fx-background-color: #E6F1FB; -fx-background-radius: 14;
                                 -fx-border-color: #B5D4F4; -fx-border-radius: 14; -fx-border-width: 0.5;
                                 -fx-cursor: hand;">
                        <Label text="Manage Users"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0C447C;"/>
                        <Label text="Add, edit, delete users"
                               style="-fx-font-size: 11px; -fx-text-fill: #185FA5;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" prefHeight="110" alignment="CENTER" spacing="8"
                          onMouseClicked="#showAppointments"
                          style="-fx-background-color: #E1F5EE; -fx-background-radius: 14;
                                 -fx-border-color: #9FE1CB; -fx-border-radius: 14; -fx-border-width: 0.5;
                                 -fx-cursor: hand;">
                        <Label text="Appointments"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #085041;"/>
                        <Label text="View &amp; manage schedule"
                               style="-fx-font-size: 11px; -fx-text-fill: #0F6E56;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" prefHeight="110" alignment="CENTER" spacing="8"
                          onMouseClicked="#showMedications"
                          style="-fx-background-color: #FAECE7; -fx-background-radius: 14;
                                 -fx-border-color: #F5C4B3; -fx-border-radius: 14; -fx-border-width: 0.5;
                                 -fx-cursor: hand;">
                        <Label text="Medications"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #712B13;"/>
                        <Label text="Stock &amp; prescriptions"
                               style="-fx-font-size: 11px; -fx-text-fill: #993C1D;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" prefHeight="110" alignment="CENTER" spacing="8"
                          onMouseClicked="#showEvents"
                          style="-fx-background-color: #EEEDFE; -fx-background-radius: 14;
                                 -fx-border-color: #CECBF6; -fx-border-radius: 14; -fx-border-width: 0.5;
                                 -fx-cursor: hand;">
                        <Label text="Events"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #26215C;"/>
                        <Label text="Upcoming events"
                               style="-fx-font-size: 11px; -fx-text-fill: #534AB7;"/>
                    </VBox>
                </HBox>

                <!-- RECENT USERS -->
                <Label text="Recent Users"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <VBox style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #e0e0e0; -fx-border-radius: 14; -fx-border-width: 0.5;">
                    <TableView fx:id="recentUsersTable" prefHeight="200"
                               style="-fx-background-color: transparent; -fx-background-radius: 14;">
                        <columns>
                            <TableColumn fx:id="nameCol" text="Full Name" prefWidth="200"/>
                            <TableColumn fx:id="emailCol" text="Email" prefWidth="240"/>
                            <TableColumn fx:id="rolesCol" text="Role" prefWidth="150"/>
                            <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
