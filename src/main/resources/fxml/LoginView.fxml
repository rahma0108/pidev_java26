<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.LoginViewController"
            prefWidth="600.0" prefHeight="380.0"
            style="-fx-background-color: #f4f6f9;">

    <VBox AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          alignment="CENTER" spacing="16.0">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <Label text="MediLink"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a2b3c;"/>
        <Label text="Choisissez votre espace"
               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>

        <Button fx:id="medecinButton" text="Entrer comme Médecin" prefWidth="240.0"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 18; -fx-cursor: hand;"/>

        <Button fx:id="patientButton" text="Entrer comme Patient" prefWidth="240.0"
                style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 18; -fx-cursor: hand;"/>
    </VBox>
</AnchorPane>
