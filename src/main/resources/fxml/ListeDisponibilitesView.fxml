<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.ListeDisponibilitesViewController"
            prefWidth="900.0" prefHeight="560.0"
            stylesheets="@style.css" styleClass="app-root, medecin-page">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               styleClass="page-shell">
        <children>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                <content>
                    <StackPane styleClass="page-content-shell">
                        <children>
                            <VBox maxWidth="1240.0"
                                  prefWidth="1180.0"
                                  spacing="28.0"
                                  styleClass="main-content, medecin-layout, page-frame">
                                <padding>
                                    <Insets top="28.0" right="34.0" bottom="34.0" left="34.0"/>
                                </padding>

                                <VBox spacing="20.0" styleClass="header-stack">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="topbar-card, header-card, doctor-topbar">
                                            <children>
                                                <VBox spacing="3.0" prefWidth="250.0" minWidth="220.0" styleClass="header-brand-block">
                                                    <children>
                                                        <Label text="MediLink" styleClass="brand-title"/>
                                                        <Label text="Doctor workspace" styleClass="section-subtitle, header-brand-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <HBox spacing="10.0" alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="header-nav-shell">
                                                    <children>
                                                        <Label text="Accueil" styleClass="nav-link"/>
                                                        <Label text="Evenements" styleClass="nav-link"/>
                                                        <Label text="Rendez-vous" styleClass="nav-link, nav-link-active"/>
                                                    </children>
                                                </HBox>
                                                <VBox spacing="6.0" alignment="CENTER_RIGHT" prefWidth="220.0" minWidth="200.0" styleClass="header-status-shell">
                                                    <children>
                                                        <Label text="Espace medecin" styleClass="nav-status-chip"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <VBox spacing="16.0" styleClass="doctor-hero-card, hero-card">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="hero-title-row">
                                                    <children>
                                                        <StackPane styleClass="doctor-hero-icon-shell">
                                                            <children>
                                                                <Label text="MD" styleClass="doctor-hero-icon"/>
                                                            </children>
                                                        </StackPane>
                                                        <VBox spacing="6.0">
                                                            <children>
                                                                <Label text="Mes disponibilites et rendez-vous" styleClass="page-title, doctor-page-title"/>
                                                                <Label text="Organisez vos creneaux et suivez vos rendez-vous dans une interface lisible et moderne." styleClass="page-subtitle, doctor-page-subtitle"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="hero-meta-row">
                                                    <children>
                                                        <Label text="Vue medecin" styleClass="doctor-context-pill"/>
                                                        <Label text="Disponibilites actives" styleClass="doctor-context-pill, doctor-context-pill-soft"/>
                                                        <Label text="Actions rapides" styleClass="doctor-context-pill, doctor-context-pill-soft"/>
                                                    </children>
                                                </HBox>
                                                <Label text="Retrouvez sur une meme page vos rendez-vous, vos disponibilites et vos actions principales, avec un affichage plus fluide et mieux reparti sur toute la largeur."
                                                       wrapText="true"
                                                       styleClass="section-subtitle, hero-wide-text"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox spacing="16.0" styleClass="content-card, appointments-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="content-header">
                                            <children>
                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Mes rendez-vous" styleClass="section-title"/>
                                                        <Label text="Recherchez, triez et gerer vos rendez-vous sans TableView." styleClass="section-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <Label fx:id="rendezVousCountLabel"
                                                       text="0 rendez-vous"
                                                       styleClass="selection-pill, doctor-selection-pill"/>
                                            </children>
                                        </HBox>

                                        <VBox spacing="14.0" styleClass="rdv-toolbar-shell">
                                            <children>
                                                <HBox spacing="14.0" alignment="CENTER_LEFT" styleClass="rdv-toolbar-row">
                                                    <children>
                                                        <TextField fx:id="rendezVousSearchField"
                                                                   promptText="Rechercher par patient, motif..."
                                                                   HBox.hgrow="ALWAYS"
                                                                   styleClass="search-field"/>
                                                        <ComboBox fx:id="rendezVousStatutComboBox"
                                                                  prefWidth="220.0"
                                                                  promptText="Tous les statuts"/>
                                                        <DatePicker fx:id="filtreDatePicker"
                                                                    promptText="Date min."
                                                                    prefWidth="190.0"
                                                                    styleClass="rdv-date-filter"/>
                                                        <Button fx:id="rafraichirButton"
                                                                text="Rafraichir"
                                                                styleClass="secondary-button, rdv-toolbar-button, rdv-refresh-button"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="12.0" alignment="CENTER_RIGHT" styleClass="rdv-sort-row">
                                                    <children>
                                                        <Button fx:id="triDateCroissantButton" text="Date croissante" styleClass="secondary-button, rdv-toolbar-button"/>
                                                        <Button fx:id="triDateDecroissantButton" text="Date decroissante" styleClass="secondary-button, rdv-toolbar-button"/>
                                                        <Button fx:id="resetRendezVousButton" text="Reinitialiser" styleClass="secondary-button, rdv-toolbar-button"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="0.0" styleClass="rdv-list-shell">
                                            <children>
                                                <HBox spacing="14.0" styleClass="rdv-list-header">
                                                    <children>
                                                        <Label text="Date et heure" styleClass="rdv-header-cell, rdv-col-date"/>
                                                        <Label text="Patient" styleClass="rdv-header-cell, rdv-col-patient"/>
                                                        <Label text="Motif" styleClass="rdv-header-cell, rdv-col-motif"/>
                                                        <Label text="Statut" styleClass="rdv-header-cell, rdv-col-status"/>
                                                        <Label text="Actions" styleClass="rdv-header-cell, rdv-col-actions"/>
                                                    </children>
                                                </HBox>
                                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="320.0" styleClass="rdv-list-scroll">
                                                    <content>
                                                        <VBox fx:id="rendezVousListContainer" styleClass="rdv-list-body"/>
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox spacing="16.0" VBox.vgrow="ALWAYS" styleClass="panel-card, availability-panel, content-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="content-header">
                                            <children>
                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Mes disponibilites" styleClass="section-title"/>
                                                        <Label text="Gerez vos disponibilites. Une disponibilite reservee devient non modifiable tant qu'un rendez-vous lui est lie." styleClass="section-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <Label fx:id="disponibiliteCountLabel"
                                                       text="0 disponibilites"
                                                       styleClass="selection-pill, doctor-selection-pill"/>
                                            </children>
                                        </HBox>

                                        <VBox spacing="14.0" styleClass="availability-toolbar-shell">
                                            <children>
                                                <HBox spacing="14.0" alignment="CENTER_LEFT" styleClass="availability-toolbar-row">
                                                    <children>
                                                        <ComboBox fx:id="disponibiliteStatutComboBox"
                                                                  prefWidth="220.0"
                                                                  promptText="Tous les statuts"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="ajouterButton"
                                                                text="Nouvelle disponibilite"
                                                                styleClass="primary-button, rdv-toolbar-button, availability-create-button"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="availability-sort-row">
                                                    <children>
                                                        <Button fx:id="triDisponibiliteCroissantButton" text="Date croissante" styleClass="secondary-button, rdv-toolbar-button"/>
                                                        <Button fx:id="triDisponibiliteDecroissantButton" text="Date decroissante" styleClass="secondary-button, rdv-toolbar-button"/>
                                                        <Button fx:id="resetDisponibiliteButton" text="Reset dispo" styleClass="secondary-button, rdv-toolbar-button"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="0.0" styleClass="rdv-list-shell, availability-list-shell">
                                            <children>
                                                <HBox spacing="14.0" styleClass="rdv-list-header, availability-list-header">
                                                    <children>
                                                        <Label text="Date" styleClass="rdv-header-cell, dispo-col-date"/>
                                                        <Label text="Heure debut" styleClass="rdv-header-cell, dispo-col-start"/>
                                                        <Label text="Heure fin" styleClass="rdv-header-cell, dispo-col-end"/>
                                                        <Label text="Statut" styleClass="rdv-header-cell, dispo-col-status"/>
                                                        <Label text="Actions" styleClass="rdv-header-cell, dispo-col-actions"/>
                                                    </children>
                                                </HBox>
                                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="320.0" styleClass="rdv-list-scroll, availability-list-scroll">
                                                    <content>
                                                        <VBox fx:id="disponibiliteListContainer" styleClass="rdv-list-body, availability-list-body"/>
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <HBox spacing="12.0" alignment="CENTER_RIGHT" styleClass="actions-bar, doctor-actions-bar, action-card">
                                    <children>
                                        <Button fx:id="retourButton" text="Retour" styleClass="secondary-button"/>
                                    </children>
                                </HBox>
                            </VBox>
                        </children>
                    </StackPane>
                </content>
            </ScrollPane>
        </children>
    </StackPane>
</AnchorPane>
