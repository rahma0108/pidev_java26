<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controllers.MedicamentController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion des Médicaments" style="-fx-font-weight: bold;">
        <font>
            <Font size="24"/>
        </font>
    </Label>

    <Separator/>

    <!-- Barre de recherche et tri -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Rechercher :" prefWidth="80"/>
        <TextField fx:id="searchField" promptText="Nom du médicament..." prefWidth="250" onKeyReleased="#rechercherMedicament"/>
        <Button text="🔍 Rechercher" onAction="#rechercherMedicament" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="🔄 Afficher tout" onAction="#rafraichirListe" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-cursor: hand;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Trier par :"/>
        <ComboBox fx:id="triCombo" prefWidth="150" onAction="#trierMedicaments"/>
    </HBox>

    <!-- Formulaire d'ajout/modification -->
    <TitledPane text="Ajouter / Modifier un médicament" animated="true" expanded="true" collapsible="true">
        <GridPane hgap="10" vgap="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250" promptText="Nom du médicament"/>

            <Label text="Quantité :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="quantiteField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="100" promptText="0"/>

            <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextArea fx:id="descriptionArea" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="350" prefHeight="80" promptText="Description..."/>

            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Button text="➕ Ajouter" onAction="#ajouterMedicament" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="✏️ Modifier" onAction="#modifierMedicament" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="🗑️ Supprimer" onAction="#supprimerMedicament" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="❌ Annuler" onAction="#viderFormulaire" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>
        </GridPane>
    </TitledPane>

    <!-- Card View (Grid) -->
    <Label text="Liste des médicaments" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
        <GridPane fx:id="cardGrid" hgap="15" vgap="15">
            <padding><Insets top="10" bottom="10"/></padding>
        </GridPane>
    </ScrollPane>

    <!-- Boutons en bas -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="📄 Exporter PDF" onAction="#exporterPDF" style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="🏠 Retour Accueil" onAction="#retourAccueil" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>
</VBox>