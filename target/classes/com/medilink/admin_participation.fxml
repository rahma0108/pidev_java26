<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medilink.controller.AdminParticipationController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <children>
        <Label text="Admin - Gestion des participations"/>
        <HBox spacing="8.0">
            <children>
                <ComboBox fx:id="cmbEvenement" prefWidth="320.0" promptText="Choisir un evenement"/>
                <Button mnemonicParsing="false" onAction="#onLoadParticipations" text="Charger participations"/>
                <Button mnemonicParsing="false" onAction="#onConfirmer" text="Confirmer"/>
                <Button mnemonicParsing="false" onAction="#onRefuser" text="Refuser"/>
            </children>
        </HBox>
        <TableView fx:id="participationTable" prefHeight="520.0" prefWidth="960.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="120.0" text="id participation"/>
                <TableColumn fx:id="colUserId" prefWidth="120.0" text="user_id"/>
                <TableColumn fx:id="colStatut" prefWidth="160.0" text="statut"/>
                <TableColumn fx:id="colDateInscription" prefWidth="280.0" text="date_inscription"/>
            </columns>
        </TableView>
    </children>
</VBox>
