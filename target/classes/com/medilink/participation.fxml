<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medilink.controller.ParticipationController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>

    <children>
        <Label text="Gestion des Participations"/>

        <HBox spacing="8.0">
            <children>
                <TextField fx:id="txtEvenementId" promptText="evenement_id"/>
                <TextField fx:id="txtStatut" promptText="statut"/>
                <TextField fx:id="txtUserId" promptText="user_id"/>
                <TextField fx:id="txtCommentaire" promptText="commentaire"/>
            </children>
        </HBox>

        <HBox spacing="8.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onAdd" text="Ajouter"/>
                <Button mnemonicParsing="false" onAction="#onUpdate" text="Modifier"/>
                <Button mnemonicParsing="false" onAction="#onDelete" text="Supprimer"/>
            </children>
        </HBox>

        <TableView fx:id="participationTable" prefHeight="500.0" prefWidth="960.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="id"/>
                <TableColumn fx:id="colEvenementId" prefWidth="120.0" text="evenement_id"/>
                <TableColumn fx:id="colStatut" prefWidth="140.0" text="statut"/>
                <TableColumn fx:id="colDateInscription" prefWidth="140.0" text="date_inscription"/>
                <TableColumn fx:id="colUserId" prefWidth="100.0" text="user_id"/>
                <TableColumn fx:id="colCommentaire" prefWidth="320.0" text="commentaire"/>
            </columns>
        </TableView>
    </children>
</VBox>
