<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medilink.controller.AdminEventController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <children>
        <Label text="Admin - Gestion des evenements"/>
        <HBox spacing="8.0">
            <children>
                <TextField fx:id="txtTitre" promptText="Titre"/>
                <TextField fx:id="txtDescription" promptText="Description"/>
                <DatePicker fx:id="dpDateEvenement" promptText="Date evenement"/>
                <TextField fx:id="txtLieu" promptText="Lieu"/>
                <TextField fx:id="txtType" promptText="Type"/>
                <TextField fx:id="txtPhoto" promptText="Photo"/>
            </children>
        </HBox>
        <HBox spacing="8.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onAdd" text="Ajouter"/>
                <Button mnemonicParsing="false" onAction="#onUpdate" text="Modifier"/>
                <Button mnemonicParsing="false" onAction="#onDelete" text="Supprimer"/>
            </children>
        </HBox>
        <TableView fx:id="eventTable" prefHeight="490.0" prefWidth="960.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70.0" text="id"/>
                <TableColumn fx:id="colTitre" prefWidth="140.0" text="titre"/>
                <TableColumn fx:id="colDescription" prefWidth="220.0" text="description"/>
                <TableColumn fx:id="colDateEvenement" prefWidth="120.0" text="date_evenement"/>
                <TableColumn fx:id="colLieu" prefWidth="150.0" text="lieu"/>
                <TableColumn fx:id="colType" prefWidth="120.0" text="type"/>
            </columns>
        </TableView>
    </children>
</VBox>
