<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.ReserverRendezVousViewController"
            prefWidth="720.0" prefHeight="520.0"
            style="-fx-background-color: #f4f6f9;">

    <VBox AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          spacing="14.0"
          style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/>
        </padding>

        <Label text="Réserver un rendez-vous"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a2b3c;"/>

        <Label text="Mode démo patient actif : patient configuré automatiquement."
               style="-fx-text-fill: #64748b; -fx-font-style: italic;"/>

        <Label text="Sélectionnez une disponibilité directement dans le tableau."
               style="-fx-text-fill: #64748b; -fx-font-style: italic;"/>

        <VBox spacing="6.0">
            <Label text="Motif (optionnel)" labelFor="$motifTextField"
                   style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <TextField fx:id="motifTextField" promptText="Consultation, suivi…"/>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Date souhaitée (filtre visuel, optionnel)" labelFor="$dateFiltrePicker"
                   style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <DatePicker fx:id="dateFiltrePicker" maxWidth="220.0" promptText="Filtrer le tableau"/>
        </VBox>

        <Label text="Créneaux (aperçu)"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>

        <TableView fx:id="creneauxTableView" VBox.vgrow="ALWAYS" minHeight="200.0">
            <columns>
                <TableColumn fx:id="colonneDispoId" text="Dispo #" prefWidth="72.0"/>
                <TableColumn fx:id="colonneDate" text="Date" prefWidth="110.0"/>
                <TableColumn fx:id="colonneHeureDebut" text="Début" prefWidth="88.0"/>
                <TableColumn fx:id="colonneHeureFin" text="Fin" prefWidth="88.0"/>
                <TableColumn fx:id="colonneStatut" text="Statut" prefWidth="120.0"/>
                <TableColumn fx:id="colonneMedecin" text="Médecin" prefWidth="160.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox spacing="12.0" alignment="CENTER_RIGHT">
            <Button fx:id="retourButton" text="Retour"
                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 18; -fx-cursor: hand;"/>
            <Button fx:id="mesRendezVousButton" text="Mes rendez-vous"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 18; -fx-cursor: hand;"/>
            <Button fx:id="reserverButton" text="Réserver" defaultButton="true"
                    style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 18; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</AnchorPane>
