<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.ReserverRendezVousViewController"
            prefWidth="1180.0" prefHeight="780.0"
            stylesheets="@style.css" styleClass="app-root, patient-page">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               styleClass="page-shell">
        <children>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                <content>
                    <StackPane styleClass="page-content-shell">
                        <children>
                            <VBox maxWidth="1240.0"
                                  prefWidth="1180.0"
                                  spacing="28.0"
                                  styleClass="main-content, patient-layout, page-frame">
                                <padding>
                                    <Insets top="28.0" right="34.0" bottom="34.0" left="34.0"/>
                                </padding>

                                <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="topbar-card, patient-topbar">
                                    <children>
                                        <VBox spacing="3.0" prefWidth="250.0" minWidth="220.0" styleClass="header-brand-block">
                                            <children>
                                                <Label text="MediLink" styleClass="brand-title"/>
                                                <Label text="Patient workspace" styleClass="section-subtitle, header-brand-subtitle"/>
                                            </children>
                                        </VBox>
                                        <HBox spacing="10.0" alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="header-nav-shell">
                                            <children>
                                                <Label text="Accueil" styleClass="nav-link"/>
                                                <Label text="Evenements" styleClass="nav-link"/>
                                                <Label text="Rendez-vous" styleClass="nav-link, nav-link-active"/>
                                                <Label text="Medicaments" styleClass="nav-link"/>
                                            </children>
                                        </HBox>
                                        <VBox spacing="6.0" alignment="CENTER_RIGHT" prefWidth="220.0" minWidth="200.0" styleClass="header-status-shell">
                                            <children>
                                                <Label text="Espace patient" styleClass="nav-status-chip"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="18.0" styleClass="content-card, patient-hero-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                                            <children>
                                                <Label text="🗓" styleClass="page-title"/>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="Prendre rendez-vous" styleClass="page-title"/>
                                                        <Label text="Choisissez une disponibilite chez un medecin et reservez votre rendez-vous." styleClass="page-subtitle"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Button fx:id="mesRendezVousButton" text="Mes preferences" styleClass="secondary-button, patient-pref-button"/>
                                                <Label fx:id="recommandationLabel"
                                                       text="Consultez vos disponibilites et vos rendez-vous en un seul endroit."
                                                       wrapText="true"
                                                       styleClass="selection-pill, patient-info-pill"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="16.0" styleClass="content-card, patient-dispo-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="content-header">
                                            <children>
                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Toutes les disponibilites" styleClass="section-title"/>
                                                        <Label text="Les creneaux affiches sont libres, futurs et relies a un medecin." styleClass="section-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <Label fx:id="disponibilitesCountLabel"
                                                       text="0 disponibilites"
                                                       styleClass="selection-pill, patient-info-pill"/>
                                            </children>
                                        </HBox>

                                        <HBox spacing="14.0" alignment="CENTER_LEFT" styleClass="patient-booking-toolbar">
                                            <children>
                                                <TextField fx:id="motifTextField"
                                                           promptText="Motif du rendez-vous (optionnel)"
                                                           HBox.hgrow="ALWAYS"
                                                           styleClass="search-field"/>
                                            </children>
                                        </HBox>

                                        <VBox spacing="0.0" styleClass="rdv-list-shell, patient-dispo-shell">
                                            <children>
                                                <HBox spacing="14.0" styleClass="rdv-list-header, patient-dispo-list-header">
                                                    <children>
                                                        <Label text="Medecin" styleClass="rdv-header-cell, patient-dispo-col-medecin"/>
                                                        <Label text="Date" styleClass="rdv-header-cell, patient-dispo-col-date"/>
                                                        <Label text="Heure" styleClass="rdv-header-cell, patient-dispo-col-time"/>
                                                        <Label text="Statut" styleClass="rdv-header-cell, patient-dispo-col-status"/>
                                                        <Label text="Action" styleClass="rdv-header-cell, patient-dispo-col-action"/>
                                                    </children>
                                                </HBox>
                                                <ScrollPane fitToWidth="true" prefViewportHeight="280.0" styleClass="rdv-list-scroll, patient-dispo-scroll">
                                                    <content>
                                                        <VBox fx:id="creneauxListContainer" styleClass="rdv-list-body, patient-dispo-list-body"/>
                                                    </content>
                                                </ScrollPane>
                                                <VBox fx:id="disponibilitesEmptyBox"
                                                      visible="false"
                                                      managed="false"
                                                      alignment="CENTER"
                                                      spacing="6.0"
                                                      styleClass="empty-state">
                                                    <children>
                                                        <Label text="Aucune disponibilite pour le moment." styleClass="empty-title"/>
                                                        <Label text="Revenez plus tard ou contactez un medecin." styleClass="empty-text"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox spacing="16.0" styleClass="content-card, patient-rdv-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="content-header">
                                            <children>
                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Mes rendez-vous" styleClass="section-title"/>
                                                        <Label text="Retrouvez ici uniquement les rendez-vous du patient connecte." styleClass="section-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <Label fx:id="mesRendezVousCountLabel"
                                                       text="0 rendez-vous"
                                                       styleClass="selection-pill, patient-info-pill"/>
                                                <Button fx:id="retourButton" text="Retour" styleClass="secondary-button"/>
                                            </children>
                                        </HBox>

                                        <VBox spacing="0.0" styleClass="rdv-list-shell, patient-rdv-list-shell">
                                            <children>
                                                <HBox spacing="14.0" styleClass="rdv-list-header, patient-rdv-list-header">
                                                    <children>
                                                        <Label text="Medecin" styleClass="rdv-header-cell, patient-col-medecin"/>
                                                        <Label text="Date et heure" styleClass="rdv-header-cell, patient-col-date"/>
                                                        <Label text="Statut" styleClass="rdv-header-cell, patient-col-status"/>
                                                        <Label text="Calendrier" styleClass="rdv-header-cell, patient-col-calendar"/>
                                                    </children>
                                                </HBox>
                                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="280.0" styleClass="rdv-list-scroll">
                                                    <content>
                                                        <VBox fx:id="mesRendezVousListContainer" styleClass="rdv-list-body"/>
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </VBox>
                        </children>
                    </StackPane>
                </content>
            </ScrollPane>
        </children>
    </StackPane>
</AnchorPane>
