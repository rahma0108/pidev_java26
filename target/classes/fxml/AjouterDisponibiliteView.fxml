<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.AjouterDisponibiliteViewController"
            prefWidth="560.0" prefHeight="520.0"
            style="-fx-background-color: #f4f6f9;">

    <VBox AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          spacing="14.0"
          style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/>
        </padding>

        <Label text="Nouvelle disponibilité"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a2b3c;"/>

        <VBox spacing="6.0">
            <Label text="Identifiant médecin" labelFor="$medecinIdTextField"
                   style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <TextField fx:id="medecinIdTextField" promptText="ex : 1" maxWidth="200.0"/>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Date" labelFor="$datePicker"
                   style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <DatePicker fx:id="datePicker" maxWidth="220.0" promptText="Choisir une date"/>
        </VBox>

        <HBox spacing="16.0" alignment="CENTER_LEFT">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label text="Heure début" labelFor="$heureDebutTextField"
                       style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <TextField fx:id="heureDebutTextField" promptText="HH:mm"/>
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label text="Heure fin" labelFor="$heureFinTextField"
                       style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <TextField fx:id="heureFinTextField" promptText="HH:mm"/>
            </VBox>
        </HBox>

        <Label text="Aperçu des créneaux (médecin sélectionné)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>

        <TableView fx:id="apercuTableView" prefHeight="160.0" minHeight="120.0">
            <columns>
                <TableColumn fx:id="colonneApercuId" text="#" prefWidth="48.0"/>
                <TableColumn fx:id="colonneApercuDate" text="Date" prefWidth="110.0"/>
                <TableColumn fx:id="colonneApercuDebut" text="Début" prefWidth="72.0"/>
                <TableColumn fx:id="colonneApercuFin" text="Fin" prefWidth="72.0"/>
                <TableColumn fx:id="colonneApercuStatut" text="Statut" minWidth="100.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <Button fx:id="ajouterButton" text="Ajouter" defaultButton="true"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 18; -fx-cursor: hand;"/>
            <Button fx:id="supprimerButton" text="Supprimer"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 18; -fx-cursor: hand;"/>
            <Button fx:id="reserverButton" text="Réserver"
                    style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 18; -fx-cursor: hand;"/>
            <Button fx:id="reinitialiserButton" text="Réinitialiser"
                    style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b; -fx-background-radius: 6; -fx-padding: 8 18; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</AnchorPane>
